# Server
PORT=4000
# Environment: dev, stag, prod
APP_ENV=dev
# CORS origins separated by ';' (example: http://localhost:3000;https://app.example.com)
CORS_ALLOWED_ORIGINS=*
# Appointment Reservation configuration
# ---------------------------------
# Reservation expiry, in seconds. Default: 300 (5 minutes).
APPOINTMENT_RESERVATION_TTL_SECONDS=300
# Minimum advance notice for a booking's start time, in hours. Default: 1.
APPOINTMENT_MIN_START_LEAD_TIME_HOURS=1
# How far ahead a booking's start time may be, in days. Default: 30.
APPOINTMENT_MAX_START_LEAD_TIME_DAYS=30


# Database
DB_USERNAME=user
DB_PASSWORD=password
DB_HOST=localhost
DB_NAME=scheduler_service
DB_PORT=5432

