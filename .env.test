# Server
PORT=4000
# Environment: dev, stag, prod
APP_ENV=dev
# CORS origins separated by ';' (example: http://localhost:3000;https://app.example.com)
CORS_ALLOWED_ORIGINS=*
# Appointment Reservation configuration
# ---------------------------------
# Reservation expiry, in seconds. Shortened so the critical-flow expiry test
# (TestCriticalFlow_ConfirmFailsWhenReservationExpired) can wait it out for
# real — there's no clock injection in this codebase.
APPOINTMENT_RESERVATION_TTL_SECONDS=5
# Minimum advance notice for a booking's start time, in hours. Default: 1.
APPOINTMENT_MIN_START_LEAD_TIME_HOURS=1
# How far ahead a booking's start time may be, in days. Deliberately ~100 years
# here: component tests book far into the future so runs never contend for a
# window against the long-lived component database (see nextStart()).
APPOINTMENT_MAX_START_LEAD_TIME_DAYS=36500


# Database
DB_USERNAME=user
DB_PASSWORD=password
DB_HOST=localhost
DB_NAME=scheduler_service
DB_PORT=5432

